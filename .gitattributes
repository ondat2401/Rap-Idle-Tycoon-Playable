## Unity YAML text-based assets - force LF, treat as text so Unity smart merge works
*.meta linguist-generated text=auto eol=lf
*.unity text=auto eol=lf merge=unityyamlmerge diff
*.asset text=auto eol=lf merge=unityyamlmerge diff
*.prefab text=auto eol=lf merge=unityyamlmerge diff
*.mat text=auto eol=lf merge=unityyamlmerge diff
*.anim text=auto eol=lf merge=unityyamlmerge diff
*.controller text=auto eol=lf merge=unityyamlmerge diff
*.overrideController text=auto eol=lf merge=unityyamlmerge diff
*.physicMaterial text=auto eol=lf merge=unityyamlmerge diff
*.physicsMaterial2D text=auto eol=lf merge=unityyamlmerge diff
*.playable text=auto eol=lf merge=unityyamlmerge diff
*.mask text=auto eol=lf merge=unityyamlmerge diff
*.brush text=auto eol=lf merge=unityyamlmerge diff
*.flare text=auto eol=lf merge=unityyamlmerge diff
*.fontsettings text=auto eol=lf merge=unityyamlmerge diff
*.guiskin text=auto eol=lf merge=unityyamlmerge diff
*.giparams text=auto eol=lf merge=unityyamlmerge diff
*.renderTexture text=auto eol=lf merge=unityyamlmerge diff
*.spriteatlas text=auto eol=lf merge=unityyamlmerge diff
*.terrainlayer text=auto eol=lf merge=unityyamlmerge diff
*.mixer text=auto eol=lf merge=unityyamlmerge diff
*.shadervariants text=auto eol=lf merge=unityyamlmerge diff
*.preset text=auto eol=lf merge=unityyamlmerge diff
*.asmdef text=auto eol=lf
*.cs text=auto eol=lf diff=csharp
*.shader text=auto eol=lf
*.cginc text=auto eol=lf
*.hlsl text=auto eol=lf
*.json text=auto eol=lf
*.md text=auto eol=lf
*.txt text=auto eol=lf

